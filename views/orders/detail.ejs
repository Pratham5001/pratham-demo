<%- include('../partials/header', {title: 'Order Details'}) %>
<div class="section-padding">
  <div class="container" style="max-width:700px">
    <a href="/orders" style="color:var(--text-muted);text-decoration:none;font-size:0.9rem"><i class="fas fa-arrow-left me-2"></i>Back to Orders</a>
    <div class="d-flex justify-content-between align-items-center mt-3 mb-4">
      <h2 class="section-title">Order Details</h2>
      <span class="status-badge status-<%= order.orderStatus %>" style="font-size:0.9rem;padding:6px 16px"><%= order.orderStatus %></span>
    </div>
    <div class="form-container mb-3">
      <div style="font-weight:700;color:var(--primary);margin-bottom:4px"><%= order.orderNumber %></div>
      <div style="font-size:0.85rem;color:var(--text-muted)">Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %></div>
      <hr>
      <% order.items.forEach(item => { %>
      <div class="d-flex gap-3 align-items-center mb-2">
        <img src="<%= item.image %>" style="width:64px;height:64px;border-radius:8px;object-fit:cover">
        <div style="flex:1"><div style="font-weight:600"><%= item.title %></div><div style="font-size:0.82rem;color:var(--text-muted)">Qty: <%= item.quantity %></div></div>
        <div style="font-weight:600">₹<%= (item.price * item.quantity).toLocaleString() %></div>
      </div>
      <% }) %>
      <hr>
      <div class="d-flex justify-content-between"><strong>Total</strong><strong style="font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--primary)">₹<%= order.totalPrice.toLocaleString() %></strong></div>
    </div>
    <div class="form-container mb-3">
      <h6 style="font-weight:700;margin-bottom:12px">Shipping Address</h6>
      <p style="margin:0;color:var(--text-muted)"><%= order.shippingAddress.fullName %><br><%= order.shippingAddress.address %>, <%= order.shippingAddress.city %> - <%= order.shippingAddress.postalCode %><br>📞 <%= order.shippingAddress.phone %></p>
    </div>
    <div class="form-container">
      <h6 style="font-weight:700;margin-bottom:12px">Payment</h6>
      <div style="color:var(--text-muted)">Method: <strong><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Online Payment' %></strong></div>
      <div style="color:var(--text-muted)">Status: <span class="status-badge status-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
