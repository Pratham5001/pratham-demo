<%- include('../partials/header', {title: 'Checkout'}) %>

<div class="section-padding">
  <div class="container">
    <h2 class="section-title mb-4">Checkout</h2>
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="form-container">
          <h5 style="font-weight:700;margin-bottom:20px">Shipping Address</h5>
          <form action="/orders/place" method="POST" id="checkoutForm">
            <div class="row">
              <div class="col-12 form-group">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-control-custom" value="<%= user.name %>" required>
              </div>
              <div class="col-12 form-group">
                <label class="form-label">Address</label>
                <input type="text" name="address" class="form-control-custom" value="<%= user.address || '' %>" required>
              </div>
              <div class="col-md-6 form-group">
                <label class="form-label">City</label>
                <input type="text" name="city" class="form-control-custom" value="<%= user.city || '' %>" required>
              </div>
              <div class="col-md-3 form-group">
                <label class="form-label">Postal Code</label>
                <input type="text" name="postalCode" class="form-control-custom" required>
              </div>
              <div class="col-md-3 form-group">
                <label class="form-label">Phone</label>
                <input type="text" name="phone" class="form-control-custom" value="<%= user.phone || '' %>" required>
              </div>
            </div>

            <hr class="my-4">
            <h5 style="font-weight:700;margin-bottom:16px">Payment Method</h5>

            <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px">
              <label style="display:flex;align-items:center;gap:12px;padding:16px;border:2px solid var(--cream-dark);border-radius:var(--radius);cursor:pointer" id="codLabel">
                <input type="radio" name="paymentMethod" value="cod" checked onchange="selectPayment('cod')">
                <div>
                  <div style="font-weight:600"><i class="fas fa-truck me-2"></i>Cash on Delivery</div>
                  <div style="font-size:0.82rem;color:var(--text-muted)">Pay when you receive your order</div>
                </div>
              </label>
              <label style="display:flex;align-items:center;gap:12px;padding:16px;border:2px solid var(--cream-dark);border-radius:var(--radius);cursor:pointer" id="onlineLabel">
                <input type="radio" name="paymentMethod" value="online" onchange="selectPayment('online')">
                <div>
                  <div style="font-weight:600"><i class="fas fa-credit-card me-2"></i>Online Payment</div>
                  <div style="font-size:0.82rem;color:var(--text-muted)">Demo: any card details accepted</div>
                </div>
              </label>
            </div>

            <div id="cardDetails" style="display:none;background:var(--cream-dark);border-radius:var(--radius);padding:16px;margin-bottom:16px">
              <div class="form-group">
                <label class="form-label">Card Number</label>
                <input type="text" class="form-control-custom" placeholder="1234 5678 9012 3456" maxlength="19">
              </div>
              <div class="row">
                <div class="col-md-6 form-group">
                  <label class="form-label">Expiry</label>
                  <input type="text" class="form-control-custom" placeholder="MM/YY">
                </div>
                <div class="col-md-6 form-group">
                  <label class="form-label">CVV</label>
                  <input type="text" class="form-control-custom" placeholder="123">
                </div>
              </div>
              <div class="alert-custom alert-info" style="font-size:0.85rem;padding:10px">
                <i class="fas fa-info-circle me-1"></i>This is a demo — no real payment is processed.
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Order Notes (optional)</label>
              <textarea name="notes" class="form-control-custom" rows="2" placeholder="Any special instructions..."></textarea>
            </div>

            <button type="submit" class="btn-primary-custom w-100" style="padding:14px;font-size:1rem">
              <i class="fas fa-check-circle me-2"></i>Place Order
            </button>
          </form>
        </div>
      </div>

      <div class="col-lg-5">
        <div style="background:var(--white);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--card-shadow)">
          <h5 style="font-weight:700;margin-bottom:16px">Order Items (<%= cart.items.length %>)</h5>
          <% cart.items.forEach(item => { %>
          <% if (item.product) { %>
          <div class="d-flex gap-3 mb-3">
            <img src="<%= item.product.images[0] %>" style="width:60px;height:60px;border-radius:8px;object-fit:cover">
            <div style="flex:1">
              <div style="font-weight:600;font-size:0.9rem"><%= item.product.title %></div>
              <div style="font-size:0.8rem;color:var(--text-muted)">Qty: <%= item.quantity %></div>
            </div>
            <div style="font-weight:600;font-size:0.9rem">₹<%= (item.price * item.quantity).toLocaleString() %></div>
          </div>
          <% } %>
          <% }) %>
          <hr>
          <div class="d-flex justify-content-between mb-1" style="font-size:0.9rem;color:var(--text-muted)">
            <span>Subtotal</span><span>₹<%= cart.totalPrice.toLocaleString() %></span>
          </div>
          <div class="d-flex justify-content-between mb-3" style="font-size:0.9rem;color:var(--text-muted)">
            <span>Delivery</span><span style="color:var(--success)">Free</span>
          </div>
          <div class="d-flex justify-content-between">
            <strong>Total</strong>
            <strong style="font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--primary)">₹<%= cart.totalPrice.toLocaleString() %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function selectPayment(method) {
  document.getElementById('cardDetails').style.display = method === 'online' ? 'block' : 'none';
  document.getElementById('codLabel').style.borderColor = method === 'cod' ? 'var(--primary)' : 'var(--cream-dark)';
  document.getElementById('onlineLabel').style.borderColor = method === 'online' ? 'var(--primary)' : 'var(--cream-dark)';
}
selectPayment('cod');
</script>

<%- include('../partials/footer') %>
