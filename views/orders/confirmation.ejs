<%- include('../partials/header', {title: 'Order Confirmed'}) %>

<div class="section-padding">
  <div class="container" style="max-width:620px">
    <div class="form-container text-center">
      <div style="width:80px;height:80px;background:#d4edda;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
        <i class="fas fa-check fa-2x" style="color:#155724"></i>
      </div>
      <h2 style="font-family:'Playfair Display',serif;margin-bottom:8px">Order Placed!</h2>
      <p style="color:var(--text-muted)">Thank you for your purchase. Your order has been confirmed.</p>
      <div style="background:var(--cream-dark);border-radius:var(--radius);padding:16px;margin:20px 0">
        <div style="font-size:0.85rem;color:var(--text-muted)">Order Number</div>
        <div style="font-size:1.3rem;font-weight:700;color:var(--primary)"><%= order.orderNumber %></div>
      </div>
      <div style="text-align:left;margin-bottom:20px">
        <% order.items.forEach(item => { %>
        <div class="d-flex gap-3 align-items-center mb-2">
          <img src="<%= item.image %>" style="width:50px;height:50px;border-radius:8px;object-fit:cover">
          <div style="flex:1"><div style="font-weight:500"><%= item.title %></div></div>
          <div style="font-weight:600">₹<%= (item.price * item.quantity).toLocaleString() %></div>
        </div>
        <% }) %>
        <hr>
        <div class="d-flex justify-content-between">
          <strong>Total Paid</strong>
          <strong style="font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--primary)">₹<%= order.totalPrice.toLocaleString() %></strong>
        </div>
        <div style="margin-top:12px;font-size:0.85rem;color:var(--text-muted)">
          Payment: <strong><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Online' %></strong> ·
          Status: <span class="status-badge status-placed"><%= order.orderStatus %></span>
        </div>
      </div>
      <div class="d-flex gap-3 justify-content-center">
        <a href="/orders/<%= order._id %>" class="btn-primary-custom">View Order</a>
        <a href="/products" class="btn-outline-primary-custom">Continue Shopping</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
