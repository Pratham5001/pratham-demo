<%- include('../partials/header', {title: 'Login'}) %>

<div style="min-height:70vh;display:flex;align-items:center;padding:60px 0;background:var(--cream-dark)">
  <div class="container" style="max-width:440px">
    <div class="form-container">
      <div class="text-center mb-4">
        <div style="font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:900;color:var(--primary)"><span style="color:var(--accent)">Thrift</span>Hub</div>
        <h2 style="font-size:1.6rem;margin-top:8px">Welcome back</h2>
        <p style="color:var(--text-muted)">Sign in to your account</p>
      </div>

      <% if (error) { %><div class="alert-custom alert-error mb-3"><%= error %></div><% } %>

      <form action="/auth/login" method="POST">
        <input type="hidden" name="redirect" value="<%= redirect %>">
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control-custom" placeholder="your@email.com" required>
        </div>
        <div class="form-group">
          <label class="form-label">Password</label>
          <div style="position:relative">
            <input type="password" name="password" id="pwd" class="form-control-custom" placeholder="••••••••" required>
            <button type="button" onclick="togglePwd()" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);cursor:pointer"><i class="fas fa-eye" id="eyeIcon"></i></button>
          </div>
        </div>
        <button type="submit" class="btn-primary-custom w-100 mt-2" style="padding:14px;font-size:1rem">Sign In</button>
      </form>

      <div class="text-center mt-4">
        <p style="color:var(--text-muted)">Don't have an account? <a href="/auth/register" style="color:var(--primary);font-weight:600;text-decoration:none">Sign up</a></p>
      </div>

      <div style="margin:20px 0;text-align:center;color:var(--text-muted);font-size:0.85rem">
        <strong>Demo:</strong> admin@thriftstore.com / admin123
      </div>
    </div>
  </div>
</div>

<script>
function togglePwd() {
  const p = document.getElementById('pwd');
  const i = document.getElementById('eyeIcon');
  if (p.type === 'password') { p.type = 'text'; i.className = 'fas fa-eye-slash'; }
  else { p.type = 'password'; i.className = 'fas fa-eye'; }
}
</script>

<%- include('../partials/footer') %>
