<%- include('../partials/header', {title: 'Manage Users'}) %>

<div style="display:flex">
  <div class="admin-sidebar">
    <div style="padding:0 24px 20px;font-family:'Playfair Display',serif;font-size:1.2rem;color:white;font-weight:700;border-bottom:1px solid rgba(255,255,255,0.1)"><span style="color:var(--accent)">Thrift</span>Hub Admin</div>
    <a href="/admin" class="admin-nav-link"><i class="fas fa-th-large" style="width:20px"></i>Dashboard</a>
    <a href="/admin/users" class="admin-nav-link active"><i class="fas fa-users" style="width:20px"></i>Users</a>
    <a href="/admin/products" class="admin-nav-link"><i class="fas fa-tshirt" style="width:20px"></i>Products</a>
    <a href="/admin/categories" class="admin-nav-link"><i class="fas fa-tags" style="width:20px"></i>Categories</a>
    <a href="/admin/orders" class="admin-nav-link"><i class="fas fa-box" style="width:20px"></i>Orders</a>
    <hr style="border-color:rgba(255,255,255,0.1);margin:16px 24px">
    <a href="/" class="admin-nav-link"><i class="fas fa-home" style="width:20px"></i>Back to Store</a>
  </div>
  <div class="admin-content">
    <h2 style="font-family:'Playfair Display',serif;margin-bottom:24px">Manage Users (<%= users.length %>)</h2>
    <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--card-shadow);overflow:hidden">
      <table style="width:100%;border-collapse:collapse">
        <thead style="background:var(--cream-dark)">
          <tr><% ['Avatar','Name','Email','Role','Status','Joined','Actions'].forEach(h => { %><th style="padding:12px 16px;font-weight:600;font-size:0.85rem;text-align:left"><%= h %></th><% }) %></tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr style="border-bottom:1px solid var(--cream-dark)" id="user-row-<%= u._id %>">
            <td style="padding:12px 16px"><img src="<%= u.avatar %>" style="width:36px;height:36px;border-radius:50%;object-fit:cover"></td>
            <td style="padding:12px 16px;font-weight:500"><%= u.name %></td>
            <td style="padding:12px 16px;font-size:0.85rem;color:var(--text-muted)"><%= u.email %></td>
            <td style="padding:12px 16px"><span style="background:<%= u.role==='admin' ? '#fff3cd' : '#e3f2fd' %>;color:<%= u.role==='admin' ? '#856404' : '#0d47a1' %>;padding:2px 10px;border-radius:10px;font-size:0.78rem;font-weight:600"><%= u.role %></span></td>
            <td style="padding:12px 16px"><span style="background:<%= u.isActive ? '#d4edda' : '#f8d7da' %>;color:<%= u.isActive ? '#155724' : '#842029' %>;padding:2px 10px;border-radius:10px;font-size:0.78rem;font-weight:600" id="status-<%= u._id %>"><%= u.isActive ? 'Active' : 'Suspended' %></span></td>
            <td style="padding:12px 16px;font-size:0.82rem;color:var(--text-muted)"><%= new Date(u.createdAt).toLocaleDateString() %></td>
            <td style="padding:12px 16px">
              <% if (u.role !== 'admin') { %>
              <button onclick="toggleUser('<%= u._id %>')" style="background:none;border:1px solid var(--cream-dark);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;font-weight:600" id="toggle-btn-<%= u._id %>">
                <%= u.isActive ? 'Suspend' : 'Activate' %>
              </button>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function toggleUser(id) {
  const r = await fetch('/admin/users/' + id + '/toggle', { method: 'POST' });
  const d = await r.json();
  if (d.success) {
    document.getElementById('status-' + id).textContent = d.isActive ? 'Active' : 'Suspended';
    document.getElementById('status-' + id).style.background = d.isActive ? '#d4edda' : '#f8d7da';
    document.getElementById('status-' + id).style.color = d.isActive ? '#155724' : '#842029';
    document.getElementById('toggle-btn-' + id).textContent = d.isActive ? 'Suspend' : 'Activate';
  }
}
</script>
