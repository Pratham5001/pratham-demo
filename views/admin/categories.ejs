<%- include('../partials/header', {title: 'Categories'}) %>
<div style="display:flex">
  <div class="admin-sidebar">
    <div style="padding:0 24px 20px;font-family:'Playfair Display',serif;font-size:1.2rem;color:white;font-weight:700;border-bottom:1px solid rgba(255,255,255,0.1)"><span style="color:var(--accent)">Thrift</span>Hub Admin</div>
    <a href="/admin" class="admin-nav-link"><i class="fas fa-th-large" style="width:20px"></i>Dashboard</a>
    <a href="/admin/users" class="admin-nav-link"><i class="fas fa-users" style="width:20px"></i>Users</a>
    <a href="/admin/products" class="admin-nav-link"><i class="fas fa-tshirt" style="width:20px"></i>Products</a>
    <a href="/admin/categories" class="admin-nav-link active"><i class="fas fa-tags" style="width:20px"></i>Categories</a>
    <a href="/admin/orders" class="admin-nav-link"><i class="fas fa-box" style="width:20px"></i>Orders</a>
    <hr style="border-color:rgba(255,255,255,0.1);margin:16px 24px">
    <a href="/" class="admin-nav-link"><i class="fas fa-home" style="width:20px"></i>Back to Store</a>
  </div>
  <div class="admin-content">
    <h2 style="font-family:'Playfair Display',serif;margin-bottom:24px">Categories</h2>
    <% if (error) { %><div class="alert-custom alert-error mb-3"><%= error %></div><% } %>

    <div class="row g-4">
      <div class="col-lg-5">
        <div style="background:var(--white);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--card-shadow)">
          <h5 style="font-weight:700;margin-bottom:16px">Add New Category</h5>
          <form action="/admin/categories" method="POST">
            <div class="form-group"><label class="form-label">Name</label><input type="text" name="name" class="form-control-custom" required></div>
            <div class="form-group"><label class="form-label">Icon (emoji)</label><input type="text" name="icon" class="form-control-custom" placeholder="👕" maxlength="4"></div>
            <div class="form-group"><label class="form-label">Description</label><input type="text" name="description" class="form-control-custom"></div>
            <button type="submit" class="btn-primary-custom w-100">Add Category</button>
          </form>
        </div>
      </div>
      <div class="col-lg-7">
        <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--card-shadow);overflow:hidden">
          <table style="width:100%;border-collapse:collapse">
            <thead style="background:var(--cream-dark)"><tr><th style="padding:12px 16px;text-align:left;font-size:0.85rem">Icon</th><th style="padding:12px 16px;text-align:left;font-size:0.85rem">Name</th><th style="padding:12px 16px;text-align:left;font-size:0.85rem">Slug</th><th style="padding:12px 16px;text-align:left;font-size:0.85rem">Action</th></tr></thead>
            <tbody>
              <% categories.forEach(cat => { %>
              <tr style="border-bottom:1px solid var(--cream-dark)" id="cat-<%= cat._id %>">
                <td style="padding:12px 16px;font-size:1.4rem"><%= cat.icon %></td>
                <td style="padding:12px 16px;font-weight:500"><%= cat.name %></td>
                <td style="padding:12px 16px;font-size:0.82rem;color:var(--text-muted)"><%= cat.slug %></td>
                <td style="padding:12px 16px">
                  <button onclick="delCat('<%= cat._id %>')" style="background:#f8d7da;color:#842029;border:none;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;font-weight:600">Delete</button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function delCat(id) {
  if (!confirm('Delete category?')) return;
  await fetch('/admin/categories/' + id, { method: 'DELETE' });
  document.getElementById('cat-' + id)?.remove();
}
</script>
