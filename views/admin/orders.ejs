<%- include('../partials/header', {title: 'Manage Orders'}) %>
<div style="display:flex">
  <div class="admin-sidebar">
    <div style="padding:0 24px 20px;font-family:'Playfair Display',serif;font-size:1.2rem;color:white;font-weight:700;border-bottom:1px solid rgba(255,255,255,0.1)"><span style="color:var(--accent)">Thrift</span>Hub Admin</div>
    <a href="/admin" class="admin-nav-link"><i class="fas fa-th-large" style="width:20px"></i>Dashboard</a>
    <a href="/admin/users" class="admin-nav-link"><i class="fas fa-users" style="width:20px"></i>Users</a>
    <a href="/admin/products" class="admin-nav-link"><i class="fas fa-tshirt" style="width:20px"></i>Products</a>
    <a href="/admin/categories" class="admin-nav-link"><i class="fas fa-tags" style="width:20px"></i>Categories</a>
    <a href="/admin/orders" class="admin-nav-link active"><i class="fas fa-box" style="width:20px"></i>Orders</a>
    <hr style="border-color:rgba(255,255,255,0.1);margin:16px 24px">
    <a href="/" class="admin-nav-link"><i class="fas fa-home" style="width:20px"></i>Back to Store</a>
  </div>
  <div class="admin-content">
    <h2 style="font-family:'Playfair Display',serif;margin-bottom:24px">Orders (<%= orders.length %>)</h2>
    <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--card-shadow);overflow:auto">
      <table style="width:100%;border-collapse:collapse;min-width:800px">
        <thead style="background:var(--cream-dark)">
          <tr><% ['Order #','Buyer','Items','Total','Payment','Status','Date','Update'].forEach(h => { %><th style="padding:12px 16px;font-weight:600;font-size:0.85rem;text-align:left"><%= h %></th><% }) %></tr>
        </thead>
        <tbody>
          <% orders.forEach(order => { %>
          <tr style="border-bottom:1px solid var(--cream-dark)">
            <td style="padding:10px 16px;font-size:0.85rem;font-weight:600;color:var(--primary)"><%= order.orderNumber.split('-').slice(-1)[0] %></td>
            <td style="padding:10px 16px;font-size:0.85rem"><%= order.buyer?.name %></td>
            <td style="padding:10px 16px;font-size:0.82rem;color:var(--text-muted)"><%= order.items.length %> item(s)</td>
            <td style="padding:10px 16px;font-weight:600">₹<%= order.totalPrice.toLocaleString() %></td>
            <td style="padding:10px 16px"><span style="background:<%= order.paymentMethod==='cod' ? '#e3f2fd' : '#d4edda' %>;color:<%= order.paymentMethod==='cod' ? '#0d47a1' : '#155724' %>;padding:2px 8px;border-radius:10px;font-size:0.78rem;font-weight:600"><%= order.paymentMethod.toUpperCase() %></span></td>
            <td style="padding:10px 16px"><span class="status-badge status-<%= order.orderStatus %>"><%= order.orderStatus %></span></td>
            <td style="padding:10px 16px;font-size:0.82rem;color:var(--text-muted)"><%= new Date(order.createdAt).toLocaleDateString() %></td>
            <td style="padding:10px 16px">
              <select onchange="updateStatus('<%= order._id %>', this.value)" style="border:1px solid var(--cream-dark);border-radius:6px;padding:4px 8px;font-size:0.8rem;cursor:pointer">
                <% ['placed','confirmed','shipped','delivered','cancelled'].forEach(s => { %>
                <option value="<%= s %>" <%= order.orderStatus === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function updateStatus(id, status) {
  await fetch('/admin/orders/' + id + '/status', {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ status })
  });
}
</script>
