<%- include('../partials/header', {title: 'Admin Dashboard'}) %>

<div style="display:flex">
  <!-- SIDEBAR -->
  <div class="admin-sidebar">
    <div style="padding:0 24px 20px;font-family:'Playfair Display',serif;font-size:1.2rem;color:white;font-weight:700;border-bottom:1px solid rgba(255,255,255,0.1)"><span style="color:var(--accent)">Thrift</span>Hub Admin</div>
    <a href="/admin" class="admin-nav-link active"><i class="fas fa-th-large" style="width:20px"></i>Dashboard</a>
    <a href="/admin/users" class="admin-nav-link"><i class="fas fa-users" style="width:20px"></i>Users</a>
    <a href="/admin/products" class="admin-nav-link"><i class="fas fa-tshirt" style="width:20px"></i>Products</a>
    <a href="/admin/categories" class="admin-nav-link"><i class="fas fa-tags" style="width:20px"></i>Categories</a>
    <a href="/admin/orders" class="admin-nav-link"><i class="fas fa-box" style="width:20px"></i>Orders</a>
    <hr style="border-color:rgba(255,255,255,0.1);margin:16px 24px">
    <a href="/" class="admin-nav-link"><i class="fas fa-home" style="width:20px"></i>Back to Store</a>
  </div>

  <div class="admin-content">
    <h2 style="font-family:'Playfair Display',serif;margin-bottom:24px">Dashboard</h2>

    <div class="row g-4 mb-5">
      <div class="col-md-3">
        <div class="stat-card">
          <div class="stat-label">Total Users</div>
          <div class="stat-number"><%= stats.totalUsers %></div>
          <i class="fas fa-users" style="position:absolute;bottom:16px;right:16px;font-size:2rem;color:var(--cream-dark)"></i>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card">
          <div class="stat-label">Products</div>
          <div class="stat-number"><%= stats.totalProducts %></div>
          <i class="fas fa-tshirt" style="position:absolute;bottom:16px;right:16px;font-size:2rem;color:var(--cream-dark)"></i>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card">
          <div class="stat-label">Orders</div>
          <div class="stat-number"><%= stats.totalOrders %></div>
          <i class="fas fa-shopping-bag" style="position:absolute;bottom:16px;right:16px;font-size:2rem;color:var(--cream-dark)"></i>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card">
          <div class="stat-label">Revenue</div>
          <div class="stat-number" style="font-size:1.8rem">₹<%= stats.revenue.toLocaleString() %></div>
          <i class="fas fa-rupee-sign" style="position:absolute;bottom:16px;right:16px;font-size:2rem;color:var(--cream-dark)"></i>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div style="background:var(--white);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--card-shadow)">
          <h5 style="font-weight:700;margin-bottom:16px">Recent Orders</h5>
          <% recentOrders.forEach(order => { %>
          <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom:1px solid var(--cream-dark)">
            <div>
              <div style="font-size:0.85rem;font-weight:600"><%= order.orderNumber %></div>
              <div style="font-size:0.78rem;color:var(--text-muted)"><%= order.buyer?.name %></div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="status-badge status-<%= order.orderStatus %>"><%= order.orderStatus %></span>
              <strong style="font-size:0.9rem">₹<%= order.totalPrice.toLocaleString() %></strong>
            </div>
          </div>
          <% }) %>
          <a href="/admin/orders" style="color:var(--primary);font-size:0.85rem;text-decoration:none;font-weight:600">View all orders →</a>
        </div>
      </div>
      <div class="col-lg-6">
        <div style="background:var(--white);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--card-shadow)">
          <h5 style="font-weight:700;margin-bottom:16px">Recent Products</h5>
          <% recentProducts.forEach(product => { %>
          <div class="d-flex align-items-center gap-3 mb-2 pb-2" style="border-bottom:1px solid var(--cream-dark)">
            <img src="<%= product.images[0] %>" style="width:40px;height:40px;border-radius:8px;object-fit:cover">
            <div style="flex:1;min-width:0">
              <div style="font-size:0.85rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= product.title %></div>
              <div style="font-size:0.78rem;color:var(--text-muted)">by <%= product.seller?.name %></div>
            </div>
            <strong style="font-size:0.9rem;color:var(--primary)">₹<%= product.price %></strong>
          </div>
          <% }) %>
          <a href="/admin/products" style="color:var(--primary);font-size:0.85rem;text-decoration:none;font-weight:600">View all products →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
