<%- include('../partials/header', {title: 'Manage Products'}) %>
<div style="display:flex">
  <div class="admin-sidebar">
    <div style="padding:0 24px 20px;font-family:'Playfair Display',serif;font-size:1.2rem;color:white;font-weight:700;border-bottom:1px solid rgba(255,255,255,0.1)"><span style="color:var(--accent)">Thrift</span>Hub Admin</div>
    <a href="/admin" class="admin-nav-link"><i class="fas fa-th-large" style="width:20px"></i>Dashboard</a>
    <a href="/admin/users" class="admin-nav-link"><i class="fas fa-users" style="width:20px"></i>Users</a>
    <a href="/admin/products" class="admin-nav-link active"><i class="fas fa-tshirt" style="width:20px"></i>Products</a>
    <a href="/admin/categories" class="admin-nav-link"><i class="fas fa-tags" style="width:20px"></i>Categories</a>
    <a href="/admin/orders" class="admin-nav-link"><i class="fas fa-box" style="width:20px"></i>Orders</a>
    <hr style="border-color:rgba(255,255,255,0.1);margin:16px 24px">
    <a href="/" class="admin-nav-link"><i class="fas fa-home" style="width:20px"></i>Back to Store</a>
  </div>
  <div class="admin-content">
    <h2 style="font-family:'Playfair Display',serif;margin-bottom:24px">Manage Products</h2>
    <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--card-shadow);overflow:auto">
      <table style="width:100%;border-collapse:collapse;min-width:700px">
        <thead style="background:var(--cream-dark)">
          <tr><% ['Image','Title','Seller','Category','Price','Status','Featured','Actions'].forEach(h => { %><th style="padding:12px 16px;font-weight:600;font-size:0.85rem;text-align:left"><%= h %></th><% }) %></tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
          <tr style="border-bottom:1px solid var(--cream-dark)" id="prod-<%= p._id %>">
            <td style="padding:10px 16px"><img src="<%= p.images[0] %>" style="width:44px;height:44px;border-radius:8px;object-fit:cover"></td>
            <td style="padding:10px 16px;font-weight:500;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><a href="/products/<%= p._id %>" target="_blank" style="color:var(--primary);text-decoration:none"><%= p.title %></a></td>
            <td style="padding:10px 16px;font-size:0.85rem"><%= p.seller?.name %></td>
            <td style="padding:10px 16px;font-size:0.85rem"><%= p.category?.name %></td>
            <td style="padding:10px 16px;font-weight:600">₹<%= p.price.toLocaleString() %></td>
            <td style="padding:10px 16px"><span style="background:<%= p.status==='available' ? '#d4edda' : '#f8d7da' %>;color:<%= p.status==='available' ? '#155724' : '#842029' %>;padding:2px 8px;border-radius:10px;font-size:0.78rem;font-weight:600"><%= p.status %></span></td>
            <td style="padding:10px 16px">
              <button onclick="toggleFeatured('<%= p._id %>', this)" style="background:<%= p.isFeatured ? 'var(--accent)' : 'var(--cream-dark)' %>;color:<%= p.isFeatured ? 'var(--primary)' : 'var(--text-muted)' %>;border:none;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;font-weight:600">
                <%= p.isFeatured ? '★ Featured' : '☆ Feature' %>
              </button>
            </td>
            <td style="padding:10px 16px">
              <button onclick="delProduct('<%= p._id %>')" style="background:#f8d7da;color:#842029;border:none;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;font-weight:600">Delete</button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function delProduct(id) {
  if (!confirm('Delete this product?')) return;
  await fetch('/admin/products/' + id, { method: 'DELETE' });
  document.getElementById('prod-' + id)?.remove();
}

async function toggleFeatured(id, btn) {
  const r = await fetch('/admin/products/' + id + '/featured', { method: 'POST' });
  const d = await r.json();
  btn.textContent = d.isFeatured ? '★ Featured' : '☆ Feature';
  btn.style.background = d.isFeatured ? 'var(--accent)' : 'var(--cream-dark)';
  btn.style.color = d.isFeatured ? 'var(--primary)' : 'var(--text-muted)';
}
</script>
