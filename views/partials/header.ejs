<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>ThriftHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg">
  <div class="container">
    <a class="navbar-brand" href="/"><span>Thrift</span>Hub</a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" style="color:white">
      <i class="fas fa-bars"></i>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-3">
        <li class="nav-item"><a class="nav-link" href="/products">Browse</a></li>
        <li class="nav-item"><a class="nav-link" href="/products?sort=price_asc">Deals</a></li>
        <% if (user) { %>
          <li class="nav-item"><a class="nav-link" href="/messages">Messages</a></li>
          <% if (user.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link text-warning" href="/admin"><i class="fas fa-shield-alt me-1"></i>Admin</a></li>
          <% } %>
        <% } %>
      </ul>
      <div class="d-flex align-items-center gap-2">
        <a href="/products?search=" class="nav-icon-btn d-lg-none"><i class="fas fa-search"></i></a>
        <% if (user) { %>
          <a href="/wishlist" class="nav-icon-btn" title="Wishlist">
            <i class="fas fa-heart"></i>
          </a>
          <a href="/cart" class="nav-icon-btn" title="Cart">
            <i class="fas fa-shopping-cart"></i>
            <span class="badge-count" id="cartCount">0</span>
          </a>
          <div class="dropdown ms-1">
            <button class="btn d-flex align-items-center gap-2 p-1" style="background:rgba(255,255,255,0.1);border:none;border-radius:20px;color:white" data-bs-toggle="dropdown">
              <img src="<%= user.avatar %>" alt="" style="width:28px;height:28px;border-radius:50%;object-fit:cover">
              <span style="font-size:0.85rem;font-weight:600"><%= user.name.split(' ')[0] %></span>
              <i class="fas fa-chevron-down" style="font-size:0.7rem"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="border-radius:12px;border:none;box-shadow:0 8px 30px rgba(0,0,0,0.15)">
              <li><a class="dropdown-item" href="/users/profile"><i class="fas fa-user me-2 text-muted"></i>My Profile</a></li>
              <li><a class="dropdown-item" href="/products/add"><i class="fas fa-plus me-2 text-muted"></i>Sell Item</a></li>
              <li><a class="dropdown-item" href="/orders"><i class="fas fa-box me-2 text-muted"></i>My Orders</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn-outline-primary-custom py-2 px-3" style="font-size:0.88rem">Login</a>
          <a href="/products/add" class="btn-sell">+ Sell</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
