<%- include('../partials/header', {title: profileUser.name}) %>
<div class="section-padding">
  <div class="container">
    <div style="background:var(--white);border-radius:var(--radius-lg);padding:32px;margin-bottom:32px;box-shadow:var(--card-shadow)">
      <div class="d-flex align-items-center gap-4 flex-wrap">
        <img src="<%= profileUser.avatar %>" style="width:90px;height:90px;border-radius:50%;object-fit:cover;border:4px solid var(--cream-dark)">
        <div style="flex:1">
          <h2 style="font-family:'Playfair Display',serif"><%= profileUser.name %></h2>
          <% if (profileUser.bio) { %><p style="color:var(--text-muted);margin:4px 0"><%= profileUser.bio %></p><% } %>
          <div style="font-size:0.85rem;color:var(--text-muted)"><i class="fas fa-calendar me-1"></i>Member since <%= new Date(profileUser.joinedAt).toLocaleDateString('en-IN',{month:'long',year:'numeric'}) %></div>
        </div>
        <% if (user && user._id.toString() !== profileUser._id.toString()) { %>
        <a href="/messages/<%= profileUser._id %>" class="btn-primary-custom"><i class="fas fa-comment me-2"></i>Send Message</a>
        <% } %>
      </div>
    </div>
    <h3 class="section-title mb-4"><%= profileUser.name %>'s Listings (<%= products.length %>)</h3>
    <% if (products.length > 0) { %>
    <div class="products-grid">
      <% products.forEach(product => { %><%- include('../partials/product-card', { product, wishlistIds: [] }) %><% }) %>
    </div>
    <% } else { %>
    <div style="text-align:center;padding:40px;color:var(--text-muted)"><p>No active listings</p></div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
