<%- include('../partials/header', {title: 'Edit Profile'}) %>
<div class="section-padding">
  <div class="container" style="max-width:600px">
    <h2 class="section-title mb-4">Edit Profile</h2>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert-custom alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert-custom alert-success"><%= success %></div><% } %>
    <div class="form-container">
      <form action="/users/profile/edit" method="POST" enctype="multipart/form-data">
        <div class="text-center mb-4">
          <img src="<%= profileUser.avatar %>" id="avatarPreview" style="width:90px;height:90px;border-radius:50%;object-fit:cover;border:3px solid var(--cream-dark)">
          <div class="mt-2"><label style="cursor:pointer;color:var(--primary);font-weight:600;font-size:0.9rem"><i class="fas fa-camera me-1"></i>Change Photo<input type="file" name="avatar" accept="image/*" style="display:none" onchange="previewAvatar(this)"></label></div>
        </div>
        <div class="row">
          <div class="col-md-6 form-group"><label class="form-label">Full Name</label><input type="text" name="name" class="form-control-custom" value="<%= profileUser.name %>" required></div>
          <div class="col-md-6 form-group"><label class="form-label">Phone</label><input type="text" name="phone" class="form-control-custom" value="<%= profileUser.phone || '' %>"></div>
        </div>
        <div class="row">
          <div class="col-md-8 form-group"><label class="form-label">Address</label><input type="text" name="address" class="form-control-custom" value="<%= profileUser.address || '' %>"></div>
          <div class="col-md-4 form-group"><label class="form-label">City</label><input type="text" name="city" class="form-control-custom" value="<%= profileUser.city || '' %>"></div>
        </div>
        <div class="form-group"><label class="form-label">Bio</label><textarea name="bio" class="form-control-custom" rows="3" placeholder="Tell buyers about yourself..."><%= profileUser.bio || '' %></textarea></div>
        <div class="d-flex gap-3 justify-content-end">
          <a href="/users/profile" class="btn-outline-primary-custom">Cancel</a>
          <button type="submit" class="btn-primary-custom"><i class="fas fa-save me-2"></i>Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>
<script>
function previewAvatar(input) {
  if (input.files[0]) { const reader = new FileReader(); reader.onload = e => document.getElementById('avatarPreview').src = e.target.result; reader.readAsDataURL(input.files[0]); }
}
</script>
<%- include('../partials/footer') %>
