<%- include('../partials/header', {title: 'Messages'}) %>
<div class="section-padding">
  <div class="container" style="max-width:700px">
    <h2 class="section-title mb-4">Messages</h2>
    <% if (!conversations || conversations.length === 0) { %>
    <div style="text-align:center;padding:60px;background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--card-shadow)">
      <div style="font-size:3.5rem">💬</div>
      <h4 style="color:var(--text-muted);margin-top:16px">No messages yet</h4>
      <p style="color:var(--text-muted)">Start chatting with sellers on product pages</p>
    </div>
    <% } else { %>
    <div style="display:flex;flex-direction:column;gap:10px">
      <% conversations.forEach(conv => { %>
      <a href="/messages/<%= conv.other._id %>" style="background:var(--white);border-radius:var(--radius);padding:16px;display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--text);box-shadow:var(--card-shadow);transition:transform 0.15s" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform=''">
        <img src="<%= conv.other.avatar %>" style="width:50px;height:50px;border-radius:50%;object-fit:cover">
        <div style="flex:1;min-width:0">
          <div style="font-weight:600"><%= conv.other.name %></div>
          <div style="font-size:0.82rem;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= conv.lastMessage.content %></div>
        </div>
        <% if (conv.unread > 0) { %>
        <span style="background:var(--primary);color:white;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700"><%= conv.unread %></span>
        <% } %>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
