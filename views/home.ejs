<%- include('partials/header') %>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="mb-4">Shop <span>Pre-loved</span><br>Fashion</h1>
        <p class="mb-4">Discover unique second-hand clothing at unbeatable prices. Sell what you no longer wear. Shop sustainably.</p>
        <form action="/products" method="GET">
          <div class="search-hero">
            <input type="text" name="search" placeholder="Search for T-shirts, Jeans, Shoes...">
            <button type="submit"><i class="fas fa-search me-2"></i>Search</button>
          </div>
        </form>
        <div class="d-flex gap-3 mt-4">
          <a href="/products" class="btn-accent">Browse All</a>
          <a href="/products/add" class="btn-outline-primary-custom" style="border-color:rgba(255,255,255,0.5);color:white">+ Sell Now</a>
        </div>
      </div>
      <div class="col-lg-6 d-none d-lg-flex justify-content-end">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:380px">
          <div style="background:rgba(255,255,255,0.1);border-radius:16px;padding:20px;text-align:center">
            <div style="font-size:2.5rem">👕</div>
            <div style="color:white;font-weight:600;font-size:0.9rem;margin-top:8px">Thousands of items</div>
          </div>
          <div style="background:rgba(232,168,56,0.2);border-radius:16px;padding:20px;text-align:center">
            <div style="font-size:2.5rem">💰</div>
            <div style="color:white;font-weight:600;font-size:0.9rem;margin-top:8px">Up to 80% off</div>
          </div>
          <div style="background:rgba(232,168,56,0.2);border-radius:16px;padding:20px;text-align:center">
            <div style="font-size:2.5rem">♻️</div>
            <div style="color:white;font-weight:600;font-size:0.9rem;margin-top:8px">Eco-friendly</div>
          </div>
          <div style="background:rgba(255,255,255,0.1);border-radius:16px;padding:20px;text-align:center">
            <div style="font-size:2.5rem">🚚</div>
            <div style="color:white;font-weight:600;font-size:0.9rem;margin-top:8px">Fast delivery</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section class="section-padding" style="background:var(--cream-dark)">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <h2 class="section-title">Shop by Category</h2>
      <a href="/products" class="text-primary-custom fw-600" style="font-weight:600;text-decoration:none">View All <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
    <div class="category-grid">
      <% categories.forEach(cat => { %>
      <a href="/products?category=<%= cat.slug %>" class="category-card">
        <span class="icon"><%= cat.icon %></span>
        <span class="name"><%= cat.name %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<% if (featured.length > 0) { %>
<section class="section-padding">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <h2 class="section-title">Featured Picks</h2>
      <a href="/products?sort=rating" style="text-decoration:none;color:var(--primary);font-weight:600">All Featured <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
    <div class="products-grid">
      <% featured.forEach(product => { %>
        <%- include('partials/product-card', { product, wishlistIds: [] }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- LATEST PRODUCTS -->
<section class="section-padding" style="background:var(--cream-dark)">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <h2 class="section-title">New Arrivals</h2>
      <a href="/products" style="text-decoration:none;color:var(--primary);font-weight:600">View All <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
    <% if (latest.length > 0) { %>
    <div class="products-grid">
      <% latest.forEach(product => { %>
        <%- include('partials/product-card', { product, wishlistIds: [] }) %>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-5">
      <div style="font-size:4rem">🛍️</div>
      <h4 style="color:var(--text-muted);margin-top:16px">No products yet</h4>
      <a href="/products/add" class="btn-accent mt-3" style="margin-top:16px">Be the first to sell!</a>
    </div>
    <% } %>
  </div>
</section>

<!-- SELL BANNER -->
<section style="background:var(--primary);padding:60px 0">
  <div class="container text-center">
    <h2 style="font-family:'Playfair Display',serif;color:white;font-size:2.2rem;margin-bottom:12px">Have clothes you no longer wear?</h2>
    <p style="color:rgba(255,255,255,0.8);font-size:1.1rem;margin-bottom:28px">Turn your wardrobe into cash. Start selling today — it's free!</p>
    <a href="/products/add" class="btn-accent" style="font-size:1.1rem;padding:14px 40px">Start Selling <i class="fas fa-arrow-right ms-2"></i></a>
  </div>
</section>

<%- include('partials/footer') %>
