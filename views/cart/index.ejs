<%- include('../partials/header', {title: 'Shopping Cart'}) %>

<div class="section-padding">
  <div class="container">
    <h2 class="section-title mb-4">Shopping Cart</h2>

    <% if (!cart || cart.items.length === 0) { %>
    <div style="text-align:center;padding:80px 20px">
      <div style="font-size:5rem">🛒</div>
      <h3 style="margin-top:20px;color:var(--text-muted)">Your cart is empty</h3>
      <p style="color:var(--text-muted)">Browse our collection and find something you love</p>
      <a href="/products" class="btn-primary-custom mt-3" style="margin-top:20px">Browse Products</a>
    </div>
    <% } else { %>

    <div class="row g-4">
      <div class="col-lg-8">
        <% cart.items.forEach(item => { %>
        <% if (item.product) { %>
        <div class="cart-item" id="cart-item-<%= item.product._id %>">
          <img src="<%= item.product.images[0] || '/images/placeholder.jpg' %>" alt="<%= item.product.title %>">
          <div style="flex:1">
            <a href="/products/<%= item.product._id %>" style="font-weight:600;text-decoration:none;color:var(--text)"><%= item.product.title %></a>
            <div style="font-size:0.85rem;color:var(--text-muted);margin-top:2px">₹<%= item.price.toLocaleString() %> each</div>
          </div>
          <div class="qty-control">
            <button class="qty-btn" onclick="updateQty('<%= item.product._id %>', <%= item.quantity - 1 %>)">−</button>
            <span id="qty-<%= item.product._id %>" style="font-weight:600;min-width:20px;text-align:center"><%= item.quantity %></span>
            <button class="qty-btn" onclick="updateQty('<%= item.product._id %>', <%= item.quantity + 1 %>)">+</button>
          </div>
          <div style="font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:700;color:var(--primary);min-width:80px;text-align:right" id="subtotal-<%= item.product._id %>">
            ₹<%= (item.price * item.quantity).toLocaleString() %>
          </div>
          <button onclick="removeFromCart('<%= item.product._id %>')" style="background:none;border:none;color:#ccc;font-size:1.1rem;cursor:pointer;padding:4px" title="Remove">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <% } %>
        <% }) %>
      </div>

      <div class="col-lg-4">
        <div style="background:var(--white);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--card-shadow);position:sticky;top:80px">
          <h5 style="font-weight:700;margin-bottom:20px">Order Summary</h5>
          <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem;color:var(--text-muted)">
            <span>Subtotal</span>
            <span id="totalDisplay">₹<%= cart.totalPrice.toLocaleString() %></span>
          </div>
          <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem;color:var(--text-muted)">
            <span>Delivery</span><span style="color:var(--success)">Free</span>
          </div>
          <hr>
          <div class="d-flex justify-content-between mb-4">
            <strong style="font-size:1.1rem">Total</strong>
            <strong style="font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--primary)" id="grandTotal">₹<%= cart.totalPrice.toLocaleString() %></strong>
          </div>
          <a href="/orders/checkout" class="btn-primary-custom d-block text-center" style="font-size:1rem;padding:14px">
            Proceed to Checkout <i class="fas fa-arrow-right ms-2"></i>
          </a>
          <a href="/products" class="btn-outline-primary-custom d-block text-center mt-2" style="padding:12px">Continue Shopping</a>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script>
async function updateQty(productId, qty) {
  if (qty < 1) { removeFromCart(productId); return; }
  const r = await fetch('/cart/update', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ productId, quantity: qty })
  });
  const d = await r.json();
  if (d.success) {
    document.getElementById('qty-' + productId).textContent = qty;
    location.reload();
  }
}

async function removeFromCart(productId) {
  await fetch('/cart/remove/' + productId, { method: 'DELETE' });
  document.getElementById('cart-item-' + productId)?.remove();
  location.reload();
}
</script>

<%- include('../partials/footer') %>
